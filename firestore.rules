rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isDriver(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validOrderStatus() {
      return request.resource.data.status in ['active', 'in_progress', 'accepted', 'cancelled'];
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.status == 'active';
      allow read: if signedIn();
      allow update: if signedIn()
        && validOrderStatus()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'driverId', 'lastDriverId', 'declinedAt', 'startedAt', 'acceptedAt'
        ])
        && (
          resource.data.status == 'active'
          && request.resource.data.status == 'in_progress'
          && request.resource.data.driverId == request.auth.uid
          || resource.data.status == 'in_progress'
          && resource.data.driverId == request.auth.uid
          && request.resource.data.status == 'active'
          && !request.resource.data.keys().hasAny(['driverId'])
          || resource.data.status == 'in_progress'
          && resource.data.driverId == request.auth.uid
          && request.resource.data.status == 'accepted'
          && request.resource.data.driverId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          && request.resource.data.status == 'cancelled'
        );
      allow delete: if false;
    }

    match /drivers/{uid} {
      allow read: if isDriver(uid);
      allow create: if isDriver(uid)
        && request.resource.data.driverId == uid
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.freeOrdersLeft == 20
        && request.resource.data.subscriptionEndsAt == null;
      allow update: if isDriver(uid)
        && request.resource.data.driverId == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'driverId',
          'name',
          'phone',
          'equipmentCategory',
          'equipmentType',
          'vehicleType',
          'licensePlate',
          'vehiclePhotoUrl',
          'isOnline',
          'onlineUpdatedAt',
          'fcmToken',
          'tokenUpdatedAt',
          'lat',
          'lon',
          'locationUpdatedAt',
          'cooldownUntil'
        ]);
      allow delete: if false;
    }
  }
}
